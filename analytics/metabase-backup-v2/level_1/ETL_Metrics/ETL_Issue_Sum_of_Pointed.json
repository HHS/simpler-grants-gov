    "graph.show_values": false,
    "graph.x_axis.title_text": "ETL date",
    "graph.metrics": [
      "total_points"
    ],
    "graph.y_axis.axis_enabled": true,
    "graph.label_value_formatting": "auto",
    "column_settings": {
      "[\"name\",\"issue_day\"]": {
        "date_abbreviate": true
      }
    },
    "series_settings": {
      "total_points": {
        "color": "#509EE3",
        "line.marker_enabled": false,
        "line.missing": "zero"
      }
    },
    "graph.dimensions": [
      "issue_day"
    ]
  }
