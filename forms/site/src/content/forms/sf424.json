  "status": "prioritized",
  "family": ["SF-424"],
  "category": "Key Personnel & Contact Forms",
  "widgets": [
    "TextWidget",
    "SelectWidget",
    "RadioWidget",
    "CheckboxWidget",
    "ApplicationAttachmentWidget"
  ],
  "sgg_form_id": "sf424",
  "description": "The standard cover page form used for most federal grant applications. Collects applicant organization information, project details, estimated funding, and authorized representative certification.",
  "new_concepts": [
    "TextWidget",
    "SelectWidget",
    "RadioWidget",
    "CheckboxWidget"
  ],
  "notes": [
    "Contact Person is OPTIONAL per XSD (minOccurs=0) but DAT marks First/Last Name as required",
    "Department/Division use V1 types (maxLength 30), unlike R&R forms which use V2 (maxLength 100)"
  ],
  "risks": [
    "Revision Type enum has combination values (e.g. AC: Increase Award, Increase Duration) that may need a custom widget",
    "State Review under E.O. 12372 references external process not modeled in SGG"
  ],
  "children": [
    {
      "kind": "section",
      "label": "Type of Submission",
      "children": [
        {
          "kind": "field",
          "id": "type-of-submission-submission-type",
          "label": "Submission Type",
          "dat_field": "01-0",
          "required": true,
          "type": "Radio group",
          "widget": "RadioWidget",
          "help_text": "Select the type of submission. Check 'Application' for a new or revised application.",
          "constraints": "enum [Preapplication, Application, Changed/Corrected Application]",
          "json_path": "submission_type",
          "xml_path": "SF424_4_0:SubmissionType"
        }
      ]
    },
    {
      "kind": "section",
      "label": "Type of Application",
      "children": [
        {
          "kind": "field",
          "id": "type-of-application-application-type",
          "label": "Application Type",
          "dat_field": "02-0",
          "required": true,
          "type": "Radio group",
          "widget": "RadioWidget",
          "help_text": "Select the type for this application: New, Continuation, or Revision.",
          "constraints": "enum [New, Continuation, Revision]",
          "json_path": "application_type",
          "xml_path": "SF424_4_0:ApplicationType"
        },
        {
          "kind": "field",
          "id": "type-of-application-revision-type",
          "label": "Revision Type",
          "dat_field": "02-04",
          "required": "Conditional (when Application Type = 'Revision')",
          "type": "Dropdown",
          "widget": "SelectWidget",
          "help_text": "If Revision, select the appropriate letter(s) indicating the type of revision.",
          "constraints": "enum [A: Increase Award, B: Decrease Award, C: Increase Duration, D: Decrease Duration, E: Other, AC, AD, BC, BD]",
          "json_path": "revision_type",
          "xml_path": "SF424_4_0:RevisionType"
        },
        {
          "kind": "field",
          "id": "type-of-application-other-revision-explanation",
          "label": "Other Revision Explanation",
          "dat_field": "02-05",
          "required": "Conditional (when Revision Type includes 'E: Other')",
          "type": "Text input",
          "widget": "TextWidget",
          "help_text": "If 'Other' revision type is selected, provide a brief explanation.",
          "constraints": "maxLength 21",
          "json_path": "revision_other_explanation",
          "xml_path": "SF424_4_0:RevisionOtherSpecify"
        }
      ]
    },
