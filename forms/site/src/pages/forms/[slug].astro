---
import { getCollection, type CollectionEntry } from "astro:content";
import type { FieldNode } from "../../content.config";
import Base from "../../layouts/Base.astro";
import FormMetadata from "../../components/forms/FormMetadata.astro";
import FormFieldTree from "../../components/forms/FormFieldTree.astro";
import Findings from "@/components/forms/comparison/Findings";
import FieldComparison from "@/components/forms/comparison/FieldComparison";
import FormDataPanel from "../../components/forms/preview/FormDataPanel";
import FormPreview from "../../components/forms/preview/FormPreview";
import { loadFormSpec } from "../../lib/formSpec";
import { compareForm } from "@parity/comparison.ts";

export async function getStaticPaths() {
  const forms = await getCollection("forms");
  return forms.map((form: CollectionEntry<"forms">) => ({
    params: { slug: form.data.slug },
    props: { form },
  }));
}

const { form } = Astro.props;
const spec = form.data.spec_id ? await loadFormSpec(form.data.spec_id) : undefined;
const comparison = await compareForm<FieldNode>(form.data);
const notes = form.data.notes ?? [];

const STATUS_LABELS: Record<string, string> = {
  backlog: "Backlog",
  prioritized: "Prioritized",
  in_progress: "In Progress",
  migrated: "Migrated",
  ready: "Ready",
};
---

<Base title={form.data.title}>
  <div class="grid-container">
    <nav class="breadcrumb-simple" aria-label="Breadcrumb">
      <a href="/forms/">Forms</a>
      <span class="breadcrumb-sep">&rsaquo;</span>
      <span>{form.data.title}</span>
    </nav>

    <div class="page-header">
      <div class="form-detail-header">
        <h1 class="page-title">{form.data.title}</h1>
        <span class={`status-badge status-badge--${form.data.status.replace("_", "-")}`}>
          {STATUS_LABELS[form.data.status] ?? form.data.status}
        </span>
      </div>
      <p class="page-description">{form.data.description}</p>
    </div>

    <FormMetadata form={form} />

    <div class="form-tabs">
        <div class="tab-bar" role="tablist" aria-label="Form details">
          <button class="tab-bar__tab tab-bar__tab--active" role="tab" id="form-tab-fields" aria-controls="form-panel-fields" aria-selected="true" tabindex="0" data-tab="fields">
            Field tree
          </button>
          {comparison && <button class="tab-bar__tab" role="tab" id="form-tab-findings" aria-controls="form-panel-findings" aria-selected="false" tabindex="-1" data-tab="findings">Findings</button>}
          {spec ? (
            <>
              <button class="tab-bar__tab" role="tab" id="form-tab-preview" aria-controls="form-panel-preview" aria-selected="false" tabindex="-1" data-tab="preview">
                Form preview
              </button>
              <button class="tab-bar__tab" role="tab" id="form-tab-data" aria-controls="form-panel-data" aria-selected="false" tabindex="-1" data-tab="data">
                Data
              </button>
            </>
          ) : (
            <>
              <button class="tab-bar__tab tab-bar__tab--disabled" disabled>Form preview</button>
              <button class="tab-bar__tab tab-bar__tab--disabled" disabled>Data</button>
            </>
          )}
          <button class="tab-bar__tab tab-bar__tab--disabled" disabled>JSON Schema</button>
          <button class="tab-bar__tab tab-bar__tab--disabled" disabled>XML Mapping</button>
        </div>

        <div id="form-panel-fields" role="tabpanel" aria-labelledby="form-tab-fields" data-panel="fields">
          <h2 class="section-title">Fields</h2>
          {form.data.children.length === 0 ? (
            <p class="text-base padding-y-4">Field details will be added when this form is prioritized for migration.</p>
          ) : comparison ? (
            <FieldComparison client:load comparison={{ children: comparison.children, fields: comparison.fields }} />
          ) : (
            <div class="field-tree">
              <FormFieldTree nodes={form.data.children} />
            </div>
          )}
          {notes.length > 0 && (
            <>
              <h2 class="section-title margin-top-4">Notes</h2>
              <p class="text-base">Context from planning. Unlike the comparison above, notes are not checked.</p>
              <ul class="plan-notes">
                {notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            </>
          )}
        </div>

        {comparison && <div id="form-panel-findings" role="tabpanel" aria-labelledby="form-tab-findings" data-panel="findings" hidden>
          <h2 class="section-title">Findings</h2>
          <Findings client:load findings={comparison.findings} />
        </div>}

        {spec && (
          <div id="form-panel-preview" role="tabpanel" aria-labelledby="form-tab-preview" data-panel="preview" hidden>
            <h2 class="section-title">Form preview</h2>
            <FormPreview
              client:only="react"
              schema={spec.schema}
              uischema={spec.uischema}
              example={spec.example}
            />
          </div>
        )}

        {spec && (
          <div id="form-panel-data" role="tabpanel" aria-labelledby="form-tab-data" data-panel="data" hidden>
            <h2 class="section-title">Form data</h2>
            <p class="text-base">The JSON entered in the form preview, updated as you type.</p>
            <FormDataPanel client:only="react" />
          </div>
        )}
    </div>
  </div>
</Base>

<script>
  for (const container of document.querySelectorAll<HTMLElement>(".form-tabs")) {
    const tabs = [...container.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const activate = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const active = other === tab;
        other.classList.toggle("tab-bar__tab--active", active);
        other.setAttribute("aria-selected", String(active));
        other.tabIndex = active ? 0 : -1;
      }
      for (const panel of container.querySelectorAll<HTMLElement>("[data-panel]")) {
        panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      }
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", event => {
        const next = event.key === "ArrowRight" ? (index + 1) % tabs.length
          : event.key === "ArrowLeft" ? (index - 1 + tabs.length) % tabs.length
          : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : null;
        if (next === null) return;
        event.preventDefault();
        activate(tabs[next]);
        tabs[next].focus();
      });
    }
  }
</script>
