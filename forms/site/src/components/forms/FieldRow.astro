---
import type { FieldNode } from "../../content.config";

interface Props {
  field: FieldNode;
}

const { field } = Astro.props;
const isRequired =
  field.required === true ||
  (typeof field.required === "string" && field.required !== "false");
const requiredLabel =
  field.required === true
    ? "* Required"
    : typeof field.required === "string" && field.required !== "false"
      ? field.required
      : undefined;
---

<div
  class="field-row"
  data-field-id={field.id}
  data-static-field-id={field.id}
  tabindex="-1"
>
  <div class="field-row__primary">
    <span class="field-row__label">{field.label}</span>
    {field.id && (
      <a
        class="review-link"
        href={`?${new URLSearchParams({ field: field.id })}`}
        aria-label={`Link to ${field.label}`}
        title={`Link to ${field.label}`}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2" />
        </svg>
      </a>
    )}
  </div>
  <div class="field-row__requirement">
    {isRequired ? (
      <span class="field-row__required">{requiredLabel}</span>
    ) : (
      <span class="field-row__optional">Optional</span>
    )}
  </div>

  {field.help_text && <div class="field-row__help">{field.help_text}</div>}

  <div class="field-row__tertiary">
    <span class="field-row__type">{field.type}</span>
    {field.widget && (
      <>
        <span class="field-row__sep">&middot;</span>
        <span>{field.widget}</span>
      </>
    )}
    {field.constraints && (
      <>
        <span class="field-row__sep">&middot;</span>
        <span>{field.constraints}</span>
      </>
    )}
  </div>

  {(field.dat_field ||
    field.json_path ||
    field.xml_path ||
    field.pre_populated ||
    field.post_populated) && (
    <details class="field-row__detail">
      <summary>Details</summary>
      <dl class="field-detail-grid">
        {field.dat_field && (
          <>
            <dt>DAT #</dt>
            <dd>{field.dat_field}</dd>
          </>
        )}
        {field.json_path && (
          <>
            <dt>JSON path</dt>
            <dd>{field.json_path}</dd>
          </>
        )}
        {field.xml_path && (
          <>
            <dt>XML path</dt>
            <dd>{field.xml_path}</dd>
          </>
        )}
        {field.pre_populated && (
          <>
            <dt>Pre-populated</dt>
            <dd>{field.pre_populated}</dd>
          </>
        )}
        {field.post_populated && (
          <>
            <dt>Post-populated</dt>
            <dd>{field.post_populated}</dd>
          </>
        )}
      </dl>
    </details>
  )}
</div>
