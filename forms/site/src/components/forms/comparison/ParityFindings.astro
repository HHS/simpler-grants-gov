---
import type { Artifact, Finding } from "@parity/result.ts";
import { STATUS } from "@/lib/comparison";

interface Props { findings: Finding[] }
const { findings } = Astro.props;
const groups = [...new Set(findings.map(finding => finding.check))].map(check => findings.filter(finding => finding.check === check));
const labels: Record<Artifact, string> = {
  plan: "Plan", dat: "DAT", xsd: "XSD", jsonSchema: "JSON Schema",
  uiSchema: "UI schema", xmlMapping: "XML rules", differenceRecord: "Difference record", index: "Schema index",
};
---

{findings.length > 0 && <section class="parity-findings" aria-label="All parity findings">
  <h2>All parity findings</h2>
  <p>Original findings from each check, including source items without a plan row. These counts describe check findings, not affected fields: several checks can report the same field. Field-table counts above stay at the cell level.</p>
  <details>
    <summary>{findings.length} check {findings.length === 1 ? "finding" : "findings"}</summary>
    {groups.map(group => <details class="check-group">
      <summary>{group[0].checkTitle} · {group.length} {group.length === 1 ? "finding" : "findings"}</summary>
      <ul>{group.map(finding => <li>
        <strong>{finding.kind}</strong>
        <span class="finding-status">{finding.status === "stale" ? "Stale record" : STATUS[finding.status].label}</span>
        {finding.anchors.map(anchor => <code>{labels[anchor.artifact]}: {anchor.path}</code>)}
        {finding.detail && <p>{finding.detail}</p>}
        {finding.entry && <p>{finding.entry.reason}</p>}
        {finding.values && <dl>
          <dt>{labels[finding.anchors[0].artifact]} value</dt><dd>{JSON.stringify(finding.values.plan)}</dd>
          <dt>{labels[finding.anchors[1].artifact]} value</dt><dd>{JSON.stringify(finding.values.source)}</dd>
        </dl>}
        {finding.recordAs && <p>Record as <code>{finding.recordAs.register}: {finding.recordAs.key}</code></p>}
      </li>)}</ul>
    </details>)}
  </details>
</section>}

<style>
  .parity-findings { margin: 2rem 0; padding-top: 1rem; border-top: 1px solid #dfe1e2; }
  .parity-findings > p { max-width: 70ch; line-height: 1.6; }
  summary { cursor: pointer; font-weight: 600; padding: .75rem 0; }
  .check-group { margin-left: 1rem; }
  li { padding: .75rem 0; }
  code { display: block; overflow-wrap: anywhere; margin: .5rem 0; font-size: .8rem; }
  .finding-status { margin-left: .75rem; font-size: .85rem; }
  li p { max-width: 85ch; line-height: 1.5; }
  dd { margin: .25rem 0 .75rem; overflow-wrap: anywhere; }
</style>
