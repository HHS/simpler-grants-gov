---
import { getCollection } from "astro:content";

import { TOTAL_FORM_SUBMISSIONS } from "../../content.config";

const forms = await getCollection("forms");
const totalForms = forms.length;
const families = new Set(forms.flatMap((f) => f.data.family));
const migrated = forms.filter((f) => f.data.status === "migrated");
const migratedCount = migrated.length;

const inProgressStatuses = ["in_progress", "in_review", "migrated"];
const inProgressForms = forms.filter((f) =>
  inProgressStatuses.includes(f.data.status),
);
const inProgressSubmissions = inProgressForms.reduce(
  (sum, f) => sum + f.data.apps_count,
  0,
);
const inProgressPct = (
  (inProgressSubmissions / TOTAL_FORM_SUBMISSIONS) *
  100
).toFixed(2);

const prioritizedStatuses = [
  "prioritized",
  "in_progress",
  "in_review",
  "migrated",
];
const prioritizedForms = forms.filter((f) =>
  prioritizedStatuses.includes(f.data.status),
);
const prioritizedSubmissions = prioritizedForms.reduce(
  (sum, f) => sum + f.data.apps_count,
  0,
);
const prioritizedPct = (
  (prioritizedSubmissions / TOTAL_FORM_SUBMISSIONS) *
  100
).toFixed(2);

const stats = [
  {
    label: "Total forms",
    value: totalForms.toString(),
    detail: `Across ${families.size} families`,
    valueClass: "",
  },
  {
    label: "Migrated",
    value: migratedCount.toString(),
    detail: `${migratedCount} of ${totalForms} forms`,
    valueClass: "stat-value--primary",
  },
  {
    label: "Form submissions covered (in progress)",
    value: `${inProgressPct}%`,
    detail: `${inProgressSubmissions.toLocaleString()} of ${TOTAL_FORM_SUBMISSIONS.toLocaleString()} form submissions`,
    valueClass: "stat-value--secondary",
  },
  {
    label: "Form submissions covered (prioritized+)",
    value: `${prioritizedPct}%`,
    detail: `${prioritizedSubmissions.toLocaleString()} of ${TOTAL_FORM_SUBMISSIONS.toLocaleString()} form submissions`,
    valueClass: "",
  },
];
---

<ul class="stats-grid">
  {stats.map((stat) => (
    <li class="stat-card">
      <div class="stat-label">{stat.label}</div>
      <div class:list={["stat-value", stat.valueClass]}>{stat.value}</div>
      <div class="stat-detail">{stat.detail}</div>
    </li>
  ))}
</ul>
