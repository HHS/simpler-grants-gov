  "description": "Application for Federal Domestic Assistance - Short Organizational.",
  "$defs": {
    "ShortOpportunity": {
      "type": "object",
      "properties": {
        "agency_name": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.agency-name"
            }
          ],
          "description": "Pre-populated from the Application cover sheet.",
          "readOnly": true
        },
        "assistance_listing": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing"
            }
          ],
          "properties": {
            "number": {
              "readOnly": true
            },
            "title": {
              "readOnly": true
            }
          }
        },
        "number": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.number"
            }
          ],
          "description": "Pre-populated from the Application cover sheet.",
          "readOnly": true
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.title"
            }
          ],
          "description": "Pre-populated from the Application cover sheet.",
          "readOnly": true
        }
      },
      "required": [
        "agency_name",
        "number",
        "title"
      ]
    },
    "ShortApplication": {
      "type": "object",
      "properties": {
        "date_received": {
          "allOf": [
            {
              "$ref": "#/$defs/application.date-received"
            }
          ],
          "description": "Completed by Grants.gov upon submission.",
          "readOnly": true
        }
      }
    },
    "ShortOrganization": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/organization.name"
        },
        "uei": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.uei"
            }
          ],
          "description": "UEI of the applicant organization. This field is pre-populated from the Application cover sheet.",
          "readOnly": true
        },
        "ein": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.ein"
            }
          ],
          "description": "Enter either TIN or EIN as assigned by the Internal Revenue Service.  If your organization is not in the US, enter 44-4444444."
        },
        "address": {
          "$ref": "#/$defs/types.address.zip-plus-four"
        },
        "web_address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "Enter the applicant's web address, if applicable.",
          "title": "Web Address"
        }
      },
      "required": [
        "name",
        "uei",
        "ein",
        "address"
      ]
    },
    "ShortApplicantType": {
      "type": "object",
      "properties": {
        "codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organization.applicant-type"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "Select a minimum of one applicant type or select up to three applicant types in accordance with agency instructions. If “Other” is selected, then specify Other Type of Applicant in text box."
        },
        "other_specify": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30,
          "description": "Enter the applicant type here if you selected \"Other (specify)\" for Type of applicant.",
          "title": "Type of Applicant Other Explanation"
        }
      },
      "required": [
        "codes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "codes": {
                "contains": {
                  "const": "X: Other (specify)"
                }
              }
            },
            "required": [
              "codes"
            ]
          },
          "then": {
            "required": [
              "other_specify"
            ]
          }
        }
      ]
    },
    "ShortApplicant": {
      "type": "object",
      "properties": {
        "organization": {
          "allOf": [
            {
              "$ref": "#/$defs/ShortOrganization"
            }
          ],
          "properties": {
            "uei": {
              "readOnly": true
            }
          }
        },
        "type": {
          "$ref": "#/$defs/ShortApplicantType"
        },
        "congressional_district": {
          "allOf": [
            {
              "$ref": "#/$defs/types.congressional-district"
            }
          ],
          "description": "Congressional District of Applicant is required: Enter the Congressional District in the format: 2 character State Abbreviation - 3 character District Number. Examples: CA-005 for California's 5th District, CA-012 for California's 12th District, NC-103 for North Carolina's 103rd District. If outside the U.S., enter 00-000."
        }
      },
      "required": [
        "organization",
        "type",
        "congressional_district"
      ]
    },
    "ShortProjectTimeline": {
      "type": "object",
      "properties": {
        "start_date": {
          "allOf": [
            {
              "$ref": "#/$defs/project.start-date"
            }
          ],
          "description": "Enter the date in the format MM/DD/YYYY."
        },
        "end_date": {
          "allOf": [
            {
              "$ref": "#/$defs/project.end-date"
            }
          ],
          "description": "Enter the date in the format MM/DD/YYYY."
        }
      },
      "required": [
        "start_date",
        "end_date"
      ]
    },
    "ShortProject": {
      "type": "object",
      "properties": {
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/project.title"
            }
          ],
          "description": "Enter a brief, descriptive title of the project."
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/project.description"
            }
          ],
          "description": "Enter a brief description of the project."
        },
        "timeline": {
          "$ref": "#/$defs/ShortProjectTimeline"
        }
      },
      "required": [
        "title",
        "description",
        "timeline"
      ]
    },
    "ShortRepresentative": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.name"
        },
        "title": {
          "$ref": "#/$defs/person.title"
        },
        "phone": {
          "$ref": "#/$defs/person.phone-number"
        },
        "fax": {
          "$ref": "#/$defs/person.fax-number"
        },
        "email": {
          "$ref": "#/$defs/person.email"
        }
      },
      "required": [
        "name",
        "title",
        "phone",
        "email"
      ]
    },
    "ShortContact": {
      "type": "object",
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/person.name"
            }
          ],
          "description": "Enter the person's name. First and last name are required."
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/person.title"
            }
          ],
          "description": "Enter the position title."
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.zip-plus-four"
            }
          ],
          "description": "Enter the person's complete address."
        },
        "phone": {
          "allOf": [
            {
              "$ref": "#/$defs/person.phone-number"
            }
          ],
          "description": "Enter the phone number."
        },
        "fax": {
          "allOf": [
            {
              "$ref": "#/$defs/person.fax-number"
            }
          ],
          "description": "Enter the fax number."
        },
        "email": {
          "allOf": [
            {
              "$ref": "#/$defs/person.email"
            }
          ],
          "description": "Enter the email address."
        }
      },
      "required": [
        "name",
        "title",
        "address",
        "phone",
        "email"
      ]
    },
    "ShortPointOfContact": {
      "type": "object",
      "properties": {
        "same_as_project_director": {
          "type": "boolean",
          "title": "Same as Project Director (if checked, fill in information same as Project Director above)"
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/person.name"
            }
          ],
          "description": "Enter the person's name. First and last name are required."
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/person.title"
            }
          ],
          "description": "Enter the position title."
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.zip-plus-four"
            }
          ],
          "description": "Enter the person's complete address."
        },
        "phone": {
          "allOf": [
            {
              "$ref": "#/$defs/person.phone-number"
            }
          ],
          "description": "Enter the phone number."
        },
        "fax": {
          "allOf": [
            {
              "$ref": "#/$defs/person.fax-number"
            }
          ],
          "description": "Enter the fax number."
        },
        "email": {
          "allOf": [
            {
              "$ref": "#/$defs/person.email"
            }
          ],
          "description": "Enter the email address."
        }
      },
      "required": [
        "name",
        "title",
        "address",
        "phone",
        "email"
      ]
    },
    "ShortContacts": {
      "type": "object",
      "properties": {
        "authorized_representative": {
          "$ref": "#/$defs/ShortRepresentative"
        },
        "project_director": {
          "$ref": "#/$defs/ShortContact"
        },
        "point_of_contact": {
          "$ref": "#/$defs/ShortPointOfContact"
        }
      },
      "required": [
        "authorized_representative",
        "project_director",
        "point_of_contact"
      ]
    },
    "certification": {
      "type": "object",
      "properties": {
        "agree": {
          "type": "boolean",
          "const": true,
          "description": "Check to select. This field is required.",
          "title": "I Agree"
        },
        "signature": {
          "allOf": [
            {
              "$ref": "#/$defs/certification.signature"
            }
          ],
          "description": "Completed by Grants.gov upon submission.",
          "title": "Signature",
          "readOnly": true
        },
        "date_signed": {
          "allOf": [
            {
              "$ref": "#/$defs/certification.date-signed"
            }
          ],
          "description": "Completed by Grants.gov upon submission.",
          "title": "Date Signed",
          "readOnly": true
        }
      },
      "required": [
        "agree"
      ],
      "description": "Read the certification statement and check to agree.",
      "title": "Certification"
    },
    "certification.signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 144,
      "description": "The signer's name, completed upon submission.",
      "title": "Signature"
    },
    "certification.date-signed": {
      "type": "string",
      "format": "date",
      "description": "The date signed, completed upon submission.",
      "title": "Date Signed"
    },
    "opportunity.agency-name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "The federal agency providing the funding opportunity.",
      "title": "Name of Federal Agency"
    },
    "opportunity.assistance-listing": {
      "type": "object",
      "properties": {
        "number": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing-number"
            }
          ],
          "description": "Pre-populated from the application cover sheet.",
          "title": "Assistance Listing Number",
          "readOnly": true
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing-title"
            }
          ],
          "description": "Pre-populated from the application cover sheet.",
          "title": "Assistance Listing Title",
          "readOnly": true
        }
      },
      "description": "The assistance listing for the funding opportunity.",
      "title": "Assistance Listing"
    },
    "opportunity.assistance-listing-number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "description": "The assistance listing number associated with this competition.",
      "title": "Assistance Listing Number"
    },
    "opportunity.assistance-listing-title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "The program title associated with the assistance listing.",
      "title": "Assistance Listing Title"
    },
    "opportunity.number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The number identifying the funding opportunity.",
      "title": "Funding Opportunity Number"
    },
    "opportunity.title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "The title of the funding opportunity.",
      "title": "Funding Opportunity Title"
    },
    "application.date-received": {
      "type": "string",
      "format": "date",
      "description": "Completed by Grants.gov upon submission.",
      "title": "Date Received"
    },
    "organization.name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the legal name of the organization.",
      "title": "Organization Name"
    },
    "organization.uei": {
      "type": "string",
      "minLength": 12,
      "maxLength": 12,
      "description": "Enter the organization's Unique Entity Identifier (UEI) from SAM.gov.",
      "title": "Organization UEI"
    },
    "organization.ein": {
      "type": "string",
      "minLength": 9,
      "maxLength": 30,
      "description": "Enter either the TIN or EIN assigned by the Internal Revenue Service.",
      "title": "EIN/TIN"
    },
    "types.address.zip-plus-four": {
      "type": "object",
      "properties": {
        "street1": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.street-1"
            }
          ],
          "description": "Enter the first line of the street address.",
          "title": "Street 1"
        },
        "street2": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.street-2"
            }
          ],
          "description": "Enter the second line of the street address.",
          "title": "Street 2"
        },
        "city": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.city"
            }
          ],
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.county"
            }
          ],
          "description": "Enter the county or parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Select the state. This field is required if the country is the United States.",
          "title": "State"
        },
        "province": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.province"
            }
          ],
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Select the country.",
          "title": "Country"
        },
        "zip_code": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.zip-code"
            }
          ],
          "description": "Enter the zip / postal code. A US ZIP code needs all nine digits (ZIP+4), and is required.",
          "title": "Zip / Postal Code"
        }
      },
      "required": [
        "street1",
        "city",
        "country"
      ],
      "description": "Enter an address. A US ZIP needs all nine digits.",
      "title": "Address",
      "allOf": [
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "properties": {
              "zip_code": {
                "minLength": 9
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "zip_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "state"
            ]
          }
        }
      ]
    },
    "StateCode": {
      "type": "string",
      "enum": [
        "AL: Alabama",
        "AK: Alaska",
