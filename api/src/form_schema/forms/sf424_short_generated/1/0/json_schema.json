{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opportunity": {
      "allOf": [
        {
          "$ref": "#/$defs/ShortOpportunity"
        }
      ],
      "properties": {
        "agency_name": {
          "readOnly": true
        },
        "assistance_listing": {
          "properties": {
            "number": {
              "readOnly": true
            },
            "title": {
              "readOnly": true
            }
          }
        },
        "number": {
          "readOnly": true
        },
        "title": {
          "readOnly": true
        }
      }
    },
    "application": {
      "allOf": [
        {
          "$ref": "#/$defs/ShortApplication"
        }
      ],
      "properties": {
        "date_received": {
          "readOnly": true
        }
      }
    },
    "applicant": {
      "allOf": [
        {
          "$ref": "#/$defs/ShortApplicant"
        }
      ],
      "properties": {
        "organization": {
          "properties": {
            "uei": {
              "readOnly": true
            }
          }
        }
      }
    },
    "project": {
      "$ref": "#/$defs/ShortProject"
    },
    "contacts": {
      "$ref": "#/$defs/ShortContacts"
    },
    "certification": {
      "allOf": [
        {
          "$ref": "#/$defs/certification"
        }
      ],
      "properties": {
        "signature": {
          "readOnly": true
        },
        "date_signed": {
          "readOnly": true
        }
      }
    }
  },
  "required": [
    "opportunity",
    "applicant",
    "project",
    "contacts",
    "certification"
  ],
