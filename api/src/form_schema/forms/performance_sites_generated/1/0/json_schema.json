{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "primary_site": {
      "allOf": [
        {
          "$ref": "#/$defs/PrimarySite"
        }
      ],
      "title": "Primary site"
    },
    "additional_sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Site"
      },
      "maxItems": 299,
      "description": "Add up to 299 additional project/performance site locations. Each entry has independent answers.",
      "title": "Additional site"
    },
    "additional_locations_attachment": {
      "allOf": [
        {
          "$ref": "#/$defs/types.attachment"
        }
      ],
      "description": "Attach a file listing additional locations if more than 299 additional sites are needed.",
      "title": "Additional Location(s)"
    }
  },
  "required": [
    "primary_site"
  ],
  "examples": [
    {
      "primary_site": {
        "submitting_as_individual": false,
        "organization_name": "Prairie Community Research Center",
        "uei": "PCRA12345678",
        "address": {
          "street1": "128 Oak Avenue",
          "city": "Springfield",
          "county": "Sangamon",
          "state": "IL: Illinois",
          "country": "USA: UNITED STATES",
          "zip_code": "62701-1234",
          "street2": "Suite 200"
        },
        "congressional_district": "IL-013"
      },
      "additional_sites": [
        {
          "submitting_as_individual": false,
          "organization_name": "Prairie Community Field Office",
          "uei": "PCFO12345678",
          "address": {
            "street1": "460 Cedar Street",
            "city": "Springfield",
            "county": "Sangamon",
            "state": "IL: Illinois",
            "country": "USA: UNITED STATES",
            "zip_code": "62701-1234"
          },
          "congressional_district": "IL-013"
        }
      ]
    },
    {
      "primary_site": {
        "submitting_as_individual": false,
        "organization_name": "Prairie Community Research Center",
        "uei": "PCRA12345678",
        "address": {
          "street1": "128 Oak Avenue",
          "city": "Springfield",
          "county": "Sangamon",
          "state": "IL: Illinois",
          "country": "USA: UNITED STATES",
          "zip_code": "62701-1234",
          "street2": "Suite 200"
        },
        "congressional_district": "IL-013"
      },
      "additional_sites": [
        {
          "submitting_as_individual": false,
          "organization_name": "Maple Community Research Centre",
          "uei": "MCRC12345678",
          "address": {
            "street1": "240 Maple Street",
            "street2": "Suite 210",
            "city": "Ottawa",
            "province": "Ontario",
            "country": "CAN: CANADA",
            "zip_code": "K1P 1J1"
          },
          "congressional_district": "00-000"
        }
      ]
    },
    {
      "primary_site": {
        "submitting_as_individual": true,
        "address": {
          "street1": "85 Walnut Lane",
          "city": "Springfield",
          "county": "Sangamon",
          "state": "IL: Illinois",
          "country": "USA: UNITED STATES",
          "zip_code": "62701-1234"
        },
        "congressional_district": "IL-013"
      }
    }
  ],
  "$defs": {
    "CongressionalDistrict": {
      "type": "string",
      "minLength": 6,
      "maxLength": 6,
      "pattern": "^[A-Z0-9]{2}-[A-Za-z0-9]{3}$",
      "description": "Enter the congressional district as two state characters, a hyphen and three characters."
    },
    "PrimarySite": {
      "type": "object",
      "properties": {
        "submitting_as_individual": {
          "type": "boolean",
          "description": "Select if submitting application as an individual and not on behalf of or representing any organization.",
          "title": "I am submitting an application as an individual, and not on behalf of a company, state, local or tribal government, academia, or other type of organization."
        },
        "organization_name": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.name"
            }
          ],
          "description": "Indicate the organization name of the site where the work will be performed.",
          "title": "Organization Name"
        },
        "uei": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.uei"
            }
          ],
          "description": "Enter the UEI associated with the organization where the project will be performed. This field is optional.",
          "title": "UEI"
        },
        "address": {
          "$ref": "#/$defs/types.address"
        },
        "congressional_district": {
          "allOf": [
            {
              "$ref": "#/$defs/CongressionalDistrict"
            }
          ],
          "description": "Enter the Congressional District in the format: 2 character State Abbreviation - 3 character District Number. Examples: CA-005, MD-all, US-all, 00-000. Required if the site is in the United States.",
          "title": "Project/Performance Site Congressional District"
        }
      },
      "required": [
        "address"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "submitting_as_individual": {
                "const": true
              }
            },
            "required": [
              "submitting_as_individual"
            ]
          },
          "else": {
            "required": [
              "organization_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "address": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              }
            },
            "required": [
              "address"
            ]
          },
          "then": {
            "required": [
              "congressional_district"
            ]
          }
        }
      ]
    },
    "Site": {
      "type": "object",
      "properties": {
        "submitting_as_individual": {
          "type": "boolean",
          "description": "Select if submitting application as an individual and not on behalf of or representing any organization.",
          "title": "I am submitting an application as an individual, and not on behalf of a company, state, local or tribal government, academia, or other type of organization."
        },
        "organization_name": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.name"
            }
          ],
          "description": "Indicate the organization name of the site where the work will be performed.",
          "title": "Organization Name"
        },
        "uei": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.uei"
            }
          ],
          "description": "Enter the UEI associated with the organization where the project will be performed. This field is optional.",
          "title": "UEI"
        },
        "address": {
          "$ref": "#/$defs/types.address"
        },
        "congressional_district": {
          "allOf": [
            {
              "$ref": "#/$defs/CongressionalDistrict"
            }
          ],
          "description": "Enter the Congressional District in the format: 2 character State Abbreviation - 3 character District Number. Examples: CA-005, MD-all, US-all, 00-000. Required if the site is in the United States.",
          "title": "Project/Performance Site Congressional District"
        }
      },
      "required": [
        "address"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "address": {
                "properties": {
                  "country": {
                    "const": "USA: UNITED STATES"
                  }
                },
                "required": [
                  "country"
                ]
              }
            },
            "required": [
              "address"
            ]
          },
          "then": {
            "required": [
              "congressional_district"
            ]
          }
        }
      ]
    },
    "types.attachment": {
      "type": "string",
      "format": "uuid",
      "description": "Attach a file.",
      "title": "Attachment"
    },
    "organization.name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the legal name of the organization.",
      "title": "Organization Name"
    },
    "organization.uei": {
      "type": "string",
      "minLength": 12,
      "maxLength": 12,
      "description": "Enter the organization's Unique Entity Identifier (UEI) from SAM.gov.",
      "title": "Organization UEI"
    },
    "types.address": {
      "type": "object",
      "properties": {
        "street1": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.street-1"
            }
          ],
          "description": "Enter the first line of the street address.",
          "title": "Street 1"
        },
        "street2": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.street-2"
            }
          ],
          "description": "Enter the second line of the street address.",
          "title": "Street 2"
        },
        "city": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.city"
            }
          ],
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.county"
            }
          ],
          "description": "Enter the county or parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Select the state. This field is required if the country is the United States.",
          "title": "State"
        },
        "province": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.province"
            }
          ],
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Select the country.",
          "title": "Country"
        },
        "zip_code": {
          "allOf": [
            {
              "$ref": "#/$defs/types.address.zip-code"
            }
          ],
          "description": "Enter the zip / postal code. This field is required if the country is the United States.",
          "title": "Zip / Postal Code"
        }
      },
      "required": [
        "street1",
        "city",
        "country"
      ],
      "description": "Enter an address.",
      "title": "Address",
      "allOf": [
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "zip_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "state"
            ]
          }
        }
      ]
    },
