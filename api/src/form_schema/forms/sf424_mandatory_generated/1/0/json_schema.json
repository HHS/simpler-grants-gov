      "properties": {
        "organization": {
          "properties": {
            "uei": {
              "readOnly": true
            }
          }
        }
      }
    },
    "project": {
      "$ref": "#/$defs/MandatoryProject"
    },
    "contacts": {
      "$ref": "#/$defs/MandatoryContacts"
    },
    "budget": {
      "$ref": "#/$defs/MandatoryBudget"
    },
    "certification": {
      "allOf": [
        {
          "$ref": "#/$defs/certification"
        }
      ],
      "properties": {
        "signature": {
          "readOnly": true
        },
        "date_signed": {
          "readOnly": true
        }
      }
    },
    "attachments": {
      "$ref": "#/$defs/MandatoryAttachments"
    }
  },
  "required": [
    "opportunity",
    "application",
    "applicant",
    "project",
    "contacts",
    "budget",
    "certification"
  ],
