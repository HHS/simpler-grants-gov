  "$defs": {
    "MandatoryOpportunity": {
      "type": "object",
      "properties": {
        "agency_name": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.agency-name"
            }
          ],
          "readOnly": true
        },
        "assistance_listing": {
          "allOf": [
            {
              "$ref": "#/$defs/opportunity.assistance-listing"
            }
          ],
          "properties": {
            "number": {
              "readOnly": true
            },
            "title": {
              "readOnly": true
            }
          }
        }
      },
      "required": [
        "agency_name"
      ]
    },
    "MandatorySubmissionType": {
      "type": "string",
      "enum": [
        "Application",
        "Plan",
        "FundingRequest",
        "Other"
      ]
    },
    "MandatoryFrequencyCode": {
      "type": "string",
      "enum": [
        "Annual",
        "Quarterly",
        "Other"
      ]
    },
    "MandatoryFrequency": {
      "type": "object",
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryFrequencyCode"
            }
          ],
          "description": "Select the applicable frequency for the type of submission.  This field is required."
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Specify the frequency of the submission."
        }
      },
      "required": [
        "code"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "Other"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "other"
            ]
          }
        }
      ]
    },
    "MandatoryConsolidatedRequest": {
      "type": "object",
      "properties": {
        "answer": {
          "allOf": [
            {
              "$ref": "#/$defs/types.yes-no"
            }
          ],
          "description": "Indicate if the submission is a consolidated application/plan/funding request."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "If this is a Consolidated Application/Plan/Funding Request, please identify the programs covered by the consolidated submission as required in agency instructions."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answer": {
                "const": true
              }
            },
            "required": [
              "answer"
            ]
          },
          "then": {
            "required": [
              "explanation"
            ]
          }
        }
      ]
    },
    "MandatorySubmissionVersion": {
      "type": "string",
      "enum": [
        "Initial",
        "Resubmission",
        "Revision",
        "Update"
      ]
    },
    "MandatoryApplicationState": {
      "type": "object",
      "properties": {
        "received_date": {
          "allOf": [
            {
              "$ref": "#/$defs/application.state-received-date"
            }
          ],
          "description": "Enter the date received by the State, if applicable.  Enter in the format mm/dd/yyyy."
        },
        "application_id": {
          "allOf": [
            {
              "$ref": "#/$defs/application.state-application-id"
            }
          ],
          "description": "Enter the identifier assigned by the State, if applicable."
        }
      }
    },
    "MandatoryStateReviewStatus": {
      "type": "string",
      "enum": [
        "StateReviewAvailable",
        "StateReviewNotSelected",
        "StateReviewNotNeeded"
      ]
    },
    "MandatoryStateReview": {
      "type": "object",
      "properties": {
        "status": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryStateReviewStatus"
            }
          ],
          "description": "Applicants should contact the State Single Point of Contact (SPOC) for Federal Executive Order 12372 to determine whether the application is subject to the State intergovernmental review process.   This field is required."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Enter the date the submission was provided to the State for review.  Enter in the format mm/dd/yyyy."
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "StateReviewAvailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "date"
            ]
          }
        }
      ]
    },
    "MandatoryApplication": {
      "type": "object",
      "properties": {
        "submission_type": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatorySubmissionType"
            }
          ],
          "description": "Select one type of submission in accordance with agency instructions.  This field is required."
        },
        "submission_type_other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Specify the type of submission in the text box."
        },
        "frequency": {
          "$ref": "#/$defs/MandatoryFrequency"
        },
        "consolidated_request": {
          "$ref": "#/$defs/MandatoryConsolidatedRequest"
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatorySubmissionVersion"
            }
          ],
          "description": "Select the applicable version for the type of submission.  This field is required."
        },
        "date_received": {
          "allOf": [
            {
              "$ref": "#/$defs/application.date-received"
            }
          ],
          "readOnly": true
        },
        "applicant_id": {
          "allOf": [
            {
              "$ref": "#/$defs/application.applicant-id"
            }
          ],
          "description": "If you wish to use a unique identification number for your own purposes, enter it here."
        },
        "federal_entity_identifier": {
          "allOf": [
            {
              "$ref": "#/$defs/application.federal-id"
            }
          ],
          "description": "Enter the number assigned to your organization by the Federal agency."
        },
        "federal_award_identifier": {
          "allOf": [
            {
              "$ref": "#/$defs/application.federal-award-id"
            }
          ],
          "description": "Enter the award number previously assigned by the Federal agency, if any."
        },
        "state": {
          "$ref": "#/$defs/MandatoryApplicationState"
        },
        "state_review": {
          "$ref": "#/$defs/MandatoryStateReview"
        }
      },
      "required": [
        "submission_type",
        "frequency",
        "version",
        "state_review"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "submission_type": {
                "const": "Other"
              }
            },
            "required": [
              "submission_type"
            ]
          },
          "then": {
            "required": [
              "submission_type_other"
            ]
          }
        }
      ]
    },
    "MandatoryApplicantOrganization": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/organization.name"
        },
        "uei": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.uei"
            }
          ],
          "description": "UEI of the applicant organization. This field is pre-populated from the Application cover sheet.",
          "readOnly": true
        },
        "ein": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.ein"
            }
          ],
          "description": "Enter either TIN or EIN as assigned by the Internal Revenue Service.  If your organization is not in the US, enter 44-4444444.  This field is required."
        },
        "address": {
          "$ref": "#/$defs/types.address.zip-plus-four"
        },
        "department": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.department"
            }
          ],
          "maxLength": 30,
          "description": "Enter the name of primary organizational department, service, laboratory, or equivalent level within the organization which will undertake the assistance activity."
        },
        "division": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.division"
            }
          ],
          "maxLength": 30,
          "description": "Enter the name of primary organizational division, office, or major subdivision which will undertake the assistance activity."
        }
      },
      "required": [
        "name",
        "uei",
        "ein",
        "address"
      ]
    },
    "MandatoryApplicantType": {
      "type": "object",
      "properties": {
        "code": {
          "allOf": [
            {
              "$ref": "#/$defs/organization.applicant-type"
            }
          ],
          "description": "Select the appropriate applicant type code.  This field is required."
        },
        "other_specify": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "If you selected \"Other\" in 8a, specify your applicant type here."
        },
        "additional_description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
          "description": "Enter a secondary description of applicant type, if required by the agency."
        }
      },
      "required": [
        "code"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "X: Other (specify)"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "other_specify"
            ]
          }
        }
      ]
    },
    "MandatoryDelinquentFederalDebt": {
      "type": "object",
      "properties": {
        "answer": {
          "allOf": [
            {
              "$ref": "#/$defs/types.yes-no"
            }
          ],
          "description": "This question applies to the applicant organization, not the person who signs as the authorized representative.  This field is required."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Provide an explanation of Delinquent Federal Debt in the text box."
        }
      },
      "required": [
        "answer"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "answer": {
                "const": true
              }
            },
            "required": [
              "answer"
            ]
          },
          "then": {
            "required": [
              "explanation"
            ]
          }
        }
      ]
    },
    "MandatoryApplicant": {
      "type": "object",
      "properties": {
        "organization": {
          "allOf": [
            {
              "$ref": "#/$defs/MandatoryApplicantOrganization"
            }
          ],
          "properties": {
            "uei": {
              "readOnly": true
            }
          }
        },
        "type": {
          "$ref": "#/$defs/MandatoryApplicantType"
        },
        "congressional_district": {
          "allOf": [
            {
              "$ref": "#/$defs/types.congressional-district"
            }
          ],
          "description": "Enter the Congressional District as a two-character state abbreviation, a hyphen and a three-digit district number (for example, CA-005). If outside the US, enter 00-000."
        },
        "delinquent_federal_debt": {
          "$ref": "#/$defs/MandatoryDelinquentFederalDebt"
        }
      },
      "required": [
        "organization",
        "type",
        "congressional_district",
        "delinquent_federal_debt"
      ]
    },
    "MandatoryProject": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "Enter a descriptive title of the project. This field is required."
        },
        "areas_affected": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250,
          "description": "Enter areas or entities affected using categories specified in the agency instructions."
        },
        "congressional_district": {
          "allOf": [
            {
              "$ref": "#/$defs/types.congressional-district"
            }
          ],
          "description": "Enter the Congressional District as a two-character state abbreviation, a hyphen and a three-digit district number (for example, CA-005). If outside the US, enter 00-000."
        },
        "additional_congressional_districts": {
          "allOf": [
            {
              "$ref": "#/$defs/types.attachment"
            }
          ],
          "description": "Attach a file listing additional congressional districts."
        }
      },
      "required": [
        "title"
      ]
    },
    "MandatoryRepresentativeOrganization": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.organizational-affiliation"
        }
      }
    },
    "MandatoryAuthorizedRepresentative": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.name"
        },
        "title": {
          "$ref": "#/$defs/person.title"
        },
        "organization": {
          "$ref": "#/$defs/MandatoryRepresentativeOrganization"
        },
        "phone": {
          "$ref": "#/$defs/person.phone-number"
        },
        "fax": {
          "$ref": "#/$defs/person.fax-number"
        },
        "email": {
          "$ref": "#/$defs/person.email"
        }
      },
      "required": [
        "name",
        "title",
        "phone",
        "email"
      ]
    },
    "MandatoryContactOrganization": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.organizational-affiliation"
        }
      }
    },
    "MandatoryPointOfContact": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/person.name"
        },
        "title": {
          "$ref": "#/$defs/person.title"
        },
        "organization": {
          "$ref": "#/$defs/MandatoryContactOrganization"
        },
        "phone": {
          "$ref": "#/$defs/person.phone-number"
        },
        "fax": {
          "$ref": "#/$defs/person.fax-number"
        },
        "email": {
          "$ref": "#/$defs/person.email"
        }
      },
      "required": [
        "name",
        "phone",
        "email"
      ]
    },
    "MandatoryContacts": {
      "type": "object",
      "properties": {
        "authorized_representative": {
          "$ref": "#/$defs/MandatoryAuthorizedRepresentative"
        },
        "point_of_contact": {
          "$ref": "#/$defs/MandatoryPointOfContact"
        }
      },
      "required": [
        "authorized_representative",
        "point_of_contact"
      ]
    },
    "MandatoryFundingSources": {
      "type": "object",
      "properties": {
        "federal": {
          "allOf": [
            {
              "$ref": "#/$defs/types.budget-amount"
            }
          ],
          "description": "Enter the dollar amount.  This field is required."
        },
        "match": {
          "allOf": [
            {
              "$ref": "#/$defs/types.budget-amount"
            }
          ],
          "description": "Enter the dollar amount."
        }
      },
      "required": [
        "federal"
      ]
    },
    "MandatoryFundingPeriod": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the start date of the funding period for this submission. Enter in the format mm/dd/yyyy. This field is required."
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "Enter the end date of the funding period for this submission. Enter in the format mm/dd/yyyy. This field is required."
        }
      },
      "required": [
        "start_date",
        "end_date"
      ]
    },
    "MandatoryBudget": {
      "type": "object",
      "properties": {
        "funding_sources": {
          "$ref": "#/$defs/MandatoryFundingSources"
        },
        "funding_period": {
          "$ref": "#/$defs/MandatoryFundingPeriod"
        }
      },
      "required": [
        "funding_sources",
        "funding_period"
      ]
    },
    "MandatoryAttachments": {
      "type": "object",
      "properties": {
        "additional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/types.attachment"
          },
          "maxItems": 100,
          "description": "Attach supporting documents as specified in agency instructions."
        }
      }
    },
    "certification": {
      "type": "object",
      "properties": {
        "agree": {
          "type": "boolean",
          "const": true,
          "description": "Check to select. This field is required.",
          "title": "I Agree"
        },
        "signature": {
          "allOf": [
            {
              "$ref": "#/$defs/certification.signature"
            }
          ],
