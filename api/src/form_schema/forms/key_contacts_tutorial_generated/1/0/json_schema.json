{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applicant_organization_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the legal name of the applicant that will undertake the assistance activity. This field is required.",
      "title": "Applicant Organization Name"
    },
    "key_contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tutorial_key_contact"
      },
      "minItems": 1,
      "maxItems": 4,
      "title": "Key Contacts"
    }
  },
  "required": [
    "applicant_organization_name",
    "key_contacts"
  ],
  "description": "KEY CONTACTS, rebuilt for the form library tutorial.",
  "$defs": {
    "tutorial_key_contact": {
      "type": "object",
      "properties": {
        "project_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45,
          "description": "Enter the project role of the contact person (e.g., project manager, fiscal contact). Additional contacts are optional.",
          "title": "Contact 1 Project Role"
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/name"
            }
          ],
          "description": "Enter the person's name. First and last name are required.",
          "title": "Name"
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/title"
            }
          ],
          "description": "Enter the position title.",
          "title": "Title"
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/$defs/address"
            }
          ],
          "description": "Enter the person's complete address.",
          "title": "Address"
        },
        "phone": {
          "allOf": [
            {
              "$ref": "#/$defs/phone_number"
            }
          ],
          "description": "Enter the phone number.",
          "title": "Phone Number"
        },
        "fax": {
          "allOf": [
            {
              "$ref": "#/$defs/fax_number"
            }
          ],
          "description": "Enter the fax number.",
          "title": "Fax Number"
        },
        "email": {
          "allOf": [
            {
              "$ref": "#/$defs/email"
            }
          ],
          "description": "Enter the email address.",
          "title": "Email"
        },
        "organizational_affiliation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Enter the Organizational Affiliation of the person to contact on matters related to this application.",
          "title": "Organizational Affiliation"
        }
      },
      "required": [
        "project_role",
        "name",
        "address",
        "phone",
        "email"
      ],
      "description": "One key contact: a project role and an affiliation around the question bank's `Person`."
    },
    "name": {
      "type": "object",
      "properties": {
        "prefix": {
          "allOf": [
            {
              "$ref": "#/$defs/prefix"
            }
          ],
          "title": "Prefix"
        },
        "first_name": {
          "allOf": [
            {
              "$ref": "#/$defs/first_name"
            }
          ],
          "title": "First Name"
        },
        "middle_name": {
          "allOf": [
            {
              "$ref": "#/$defs/middle_name"
            }
          ],
          "title": "Middle Name"
        },
        "last_name": {
          "allOf": [
            {
              "$ref": "#/$defs/last_name"
            }
          ],
          "title": "Last Name"
        },
        "suffix": {
          "allOf": [
            {
              "$ref": "#/$defs/suffix"
            }
          ],
          "title": "Suffix"
        }
      },
      "required": [
        "first_name",
        "last_name"
      ],
      "description": "A person's name, in five parts. `HumanNameDataType` requires the first and last name.",
      "title": "Name"
    },
    "prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "Enter the prefix."
    },
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "description": "Enter the first name."
    },
    "middle_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25,
      "description": "Enter the middle name."
    },
    "last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Enter the last name."
    },
    "suffix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "Enter the suffix."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45,
      "description": "Enter the position title.",
      "title": "Title"
    },
    "address": {
      "type": "object",
      "properties": {
        "street1": {
          "allOf": [
            {
              "$ref": "#/$defs/street_1"
            }
          ],
          "description": "Enter the first line of the street address.",
          "title": "Street1"
        },
        "street2": {
          "allOf": [
            {
              "$ref": "#/$defs/street_2"
            }
          ],
          "description": "Enter the second line of the street address.",
          "title": "Street2"
        },
        "city": {
          "allOf": [
            {
              "$ref": "#/$defs/city"
            }
          ],
          "description": "Enter the city.",
          "title": "City"
        },
        "county": {
          "allOf": [
            {
              "$ref": "#/$defs/county"
            }
          ],
          "description": "Enter the county or parish.",
          "title": "County/Parish"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/$defs/StateCode"
            }
          ],
          "description": "Select the state. This field is required if the country is the United States.",
          "title": "State"
        },
        "province": {
          "allOf": [
            {
              "$ref": "#/$defs/province"
            }
          ],
          "description": "Enter the province.",
          "title": "Province"
        },
        "country": {
          "allOf": [
            {
              "$ref": "#/$defs/CountryCode"
            }
          ],
          "description": "Select the country.",
          "title": "Country"
        },
        "zip_code": {
          "allOf": [
            {
              "$ref": "#/$defs/zip_code"
            }
          ],
          "description": "Enter the zip / postal code. This field is required if the country is the United States.",
          "title": "Zip / Postal Code"
        }
      },
      "required": [
        "street1",
        "city",
        "country"
      ],
      "description": "A person's address.",
      "title": "Address",
      "allOf": [
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "zip_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "country": {
                "const": "USA: UNITED STATES"
              }
            },
            "required": [
              "country"
            ]
          },
          "then": {
            "required": [
              "state"
            ]
          }
        }
      ]
    },
