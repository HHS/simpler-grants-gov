{
  "type": "Group",
  "elements": [
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/applicant_organization_name",
          "label": "Applicant Organization Name"
        }
      ],
      "label": "Applicant Information"
    },
    {
      "type": "Group",
      "label": "Key Contacts",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/key_contacts",
          "label": "Key Contacts",
          "options": {
            "detail": {
              "type": "Group",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/project_role",
                  "label": "Contact 1 Project Role"
                },
                {
                  "type": "Group",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/name/properties/prefix",
                      "label": "Prefix"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/name/properties/first_name",
                      "label": "First Name"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/name/properties/middle_name",
                      "label": "Middle Name"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/name/properties/last_name",
                      "label": "Last Name"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/name/properties/suffix",
                      "label": "Suffix"
                    }
                  ],
                  "label": "Name",
                  "options": {
                    "description": "Enter the person's name. First and last name are required."
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/title",
                  "label": "Title"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/organizational_affiliation",
                  "label": "Organizational Affiliation"
                },
                {
                  "type": "Group",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/street1",
                      "label": "Street1"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/street2",
                      "label": "Street2"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/city",
                      "label": "City"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/county",
                      "label": "County/Parish"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/state",
                      "label": "State",
                      "rule": {
                        "effect": "ENABLE",
                        "condition": {
                          "scope": "#/properties/address/properties/country",
                          "schema": {
                            "const": "USA: UNITED STATES"
                          }
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/province",
                      "label": "Province",
                      "rule": {
                        "effect": "SHOW",
                        "condition": {
                          "scope": "#/properties/address/properties/country",
                          "schema": {
                            "allOf": [
                              {
                                "not": {
                                  "anyOf": [
                                    {
                                      "type": "null"
                                    },
                                    {
                                      "const": ""
                                    },
                                    {
                                      "type": "array",
                                      "maxItems": 0
                                    }
                                  ]
                                }
                              },
                              {
                                "not": {
                                  "const": "USA: UNITED STATES"
                                }
                              }
                            ]
                          },
                          "failWhenUndefined": true
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/country",
                      "label": "Country"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/address/properties/zip_code",
                      "label": "Zip / Postal Code"
                    }
                  ],
                  "label": "Address",
                  "options": {
                    "description": "Enter the person's complete address."
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/phone",
                  "label": "Phone Number"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/fax",
                  "label": "Fax Number"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/email",
                  "label": "Email"
                }
              ]
            }
          }
        }
      ],
      "options": {
        "description": "You may enter up to four (4) key contacts. At least one (1) contact person is required."
      }
    }
  ],
  "label": "KEY CONTACTS, rebuilt for the form library tutorial."
}
