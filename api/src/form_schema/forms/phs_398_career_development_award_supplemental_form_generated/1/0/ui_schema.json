{
  "type": "Group",
  "elements": [
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/introduction_to_application",
          "label": "1. Introduction to Application (for Resubmission and Revision applications)",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Introduction",
      "options": {
        "description": "Attach an Introduction to Application for Resubmission and Revision applications."
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/candidate_information_and_goals",
          "label": "2. Candidate Information and Goals for Career Development",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Candidate Section"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/specific_aims",
          "label": "3. Specific Aims",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/research_strategy",
          "label": "4. Research Strategy",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/progress_report_publication_list",
          "label": "5. Progress Report Publication List (for Renewal applications)",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/responsible_conduct_of_research",
          "label": "6. Training in the Responsible Conduct of Research",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Research Plan Section",
      "options": {
        "description": "Research Strategy is required. Include the Progress Report Publication List for Renewal applications. It is optional for Resubmission."
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/mentoring_plan",
          "label": "7. Candidate's Plan to Provide Mentoring",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Other Candidate Information Section"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/statements_of_support",
          "label": "8. Plans and Statements of Mentor and Co-Mentor(s)",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/letters_of_support",
          "label": "9. Letters of Support from Collaborators, Contributors, and Consultants",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Mentor, Co-Mentor, Consultant, Collaborators Section"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/institutional_environment",
          "label": "10. Description of Institutional Environment",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/institutional_commitment",
          "label": "11. Institutional Commitment to Candidate’s Research Career Development",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/candidates_contribution",
          "label": "12. Description of Candidate's Contribution to Program Goals",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Environment and Institutional Commitment to the Candidate Section"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/vertebrate_animals",
          "label": "13. Vertebrate Animals",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/select_agent_research",
          "label": "14. Select Agent Research",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/consortium_contractual_arrangements",
          "label": "15. Consortium/Contractual Arrangements",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/resource_sharing_plans",
          "label": "16. Resource Sharing Plan(s)",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/other_plans",
          "label": "17. Other Plan(s)",
          "options": {
            "widget": "Attachment"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/key_biological_and_or_chemical_resources",
          "label": "18. Authentication of Key Biological and/or Chemical Resources",
          "options": {
            "widget": "Attachment"
          }
        }
      ],
      "label": "Other Research Plan Section",
      "options": {
        "description": "Include Vertebrate Animals if you answered Yes to the animals-used question on R&R Other Project Information."
      }
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/appendix",
          "options": {
            "widget": "AttachmentArray"
          },
          "label": "19. Appendix"
        }
      ],
      "label": "Appendix"
    },
    {
      "type": "Group",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/is_us_citizen_or_national",
          "label": "20. U.S. Citizen or Non-Citizen National?",
          "options": {
            "widget": "Radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/non_us_citizenship_status",
          "label": "If no, select most appropriate Non-U.S. Citizen option",
          "options": {
            "widget": "Radio"
          },
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/is_us_citizen_or_national",
              "schema": {
                "const": false
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/permanent_resident_by_award",
          "label": "Expect permanent resident status by the award start date",
          "options": {
            "widget": "Checkbox"
          },
          "rule": {
            "effect": "ENABLE",
            "condition": {
              "scope": "#/properties/non_us_citizenship_status",
              "schema": {
                "const": "Temporary U.S. Visa"
              }
            }
          }
        }
      ],
      "label": "Citizenship"
    }
  ]
}
