<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:NSF_KeyPersonExpanded_3_3="http://apply.grants.gov/forms/NSF_KeyPersonExpanded_3_3-V3.3" xmlns:globLib="http://apply.grants.gov/system/GlobalLibrary-V2.0" xmlns:codes="http://apply.grants.gov/system/UniversalCodes-V2.0" xmlns:glob="http://apply.grants.gov/system/Global-V1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:att="http://apply.grants.gov/system/Attachments-V1.0" targetNamespace="http://apply.grants.gov/forms/NSF_KeyPersonExpanded_3_3-V3.3" elementFormDefault="qualified" attributeFormDefault="qualified" version="3.3">
	<xs:import namespace="http://apply.grants.gov/system/Attachments-V1.0" schemaLocation="https://apply07.grants.gov/apply/system/schemas/Attachments-V1.0.xsd"/>
	<xs:import namespace="http://apply.grants.gov/system/Global-V1.0" schemaLocation="https://apply07.grants.gov/apply/system/schemas/Global-V1.0.xsd"/>
	<xs:import namespace="http://apply.grants.gov/system/GlobalLibrary-V2.0" schemaLocation="https://apply07.grants.gov/apply/system/schemas/GlobalLibrary-V2.0.xsd"/>
	<xs:import namespace="http://apply.grants.gov/system/UniversalCodes-V2.0" schemaLocation="https://apply07.grants.gov/apply/system/schemas/UniversalCodes-V2.0.xsd"/>
	<xs:element name="NSF_KeyPersonExpanded_3_3">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PDPI" type="NSF_KeyPersonExpanded_3_3:PDPIProfileDataType"/>
				<xs:element name="KeyPerson" type="NSF_KeyPersonExpanded_3_3:PersonProfileDataType" minOccurs="0" maxOccurs="99"/>
				<xs:element name="AdditionalProfilesAttached" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AdditionalProfileAttached" type="att:AttachedFileDataType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="BioSketchsAttached" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BioSketchAttached" type="att:AttachedFileDataType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="SupportsAttached" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="SupportAttached" type="att:AttachedFileDataType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="CollaboratorsAttached" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CollaboratorAttached" type="att:AttachedFileDataType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="SynergisticActivitiesAttached" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="SynergisticAttached" type="att:AttachedFileDataType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="FormVersion" type="globLib:FormVersionDataType" use="required" fixed="3.3"/>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="PDPIProfileDataType">
		<xs:sequence>
			<xs:element name="Profile">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Name" type="globLib:HumanNameDataType"/>
						<xs:element name="Title" type="globLib:HumanTitleDataType" minOccurs="0"/>
						<xs:element name="Address" type="globLib:AddressDataTypeV3"/>
						<xs:element name="Phone" type="globLib:TelephoneNumberDataType"/>
						<xs:element name="Fax" type="globLib:TelephoneNumberDataType" minOccurs="0"/>
						<xs:element name="Email" type="globLib:EmailDataType"/>
						<xs:element name="OrganizationName" type="globLib:OrganizationNameDataType" minOccurs="0"/>
						<xs:element name="Department" type="globLib:DepartmentNameDataTypeV2" minOccurs="0"/>
						<xs:element name="Division" type="globLib:DivisionNameDataTypeV2" minOccurs="0"/>
						<xs:element name="ProjectRole" type="NSF_KeyPersonExpanded_3_3:ProjectRoleDataType"/>
						<xs:element name="NSFID" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="[0-9A-Z]{9}"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="BioSketchsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="BioSketchAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SupportsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="SupportAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CollaboratorsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="CollaboratorAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SynergisticActivitiesAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="SynergisticAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
				<xs:key name="ProjectRoleKey">
					<xs:selector xpath="."/>
					<xs:field xpath="NSF_KeyPersonExpanded_3_3:ProjectRole"/>
				</xs:key>
				<xs:keyref name="ProjectRoleKeyRef" refer="NSF_KeyPersonExpanded_3_3:ProjectRoleKey">
					<xs:selector xpath="./NSF_KeyPersonExpanded_3_3:OtherProjectRoleCategory"/>
					<xs:field xpath="@NSF_KeyPersonExpanded_3_3:ProjectRole"/>
				</xs:keyref>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonProfileDataType">
		<xs:sequence>
			<xs:element name="Profile">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Name" type="globLib:HumanNameDataType"/>
						<xs:element name="Title" type="globLib:HumanTitleDataType" minOccurs="0"/>
						<xs:element name="Address" type="globLib:AddressDataTypeV3"/>
						<xs:element name="Phone" type="globLib:TelephoneNumberDataType"/>
						<xs:element name="Fax" type="globLib:TelephoneNumberDataType" minOccurs="0"/>
						<xs:element name="Email" type="globLib:EmailDataType"/>
						<xs:element name="OrganizationUEIID" type="globLib:SAMUEIDataType" minOccurs="0"/>
						<xs:element name="Department" type="globLib:DepartmentNameDataTypeV2" minOccurs="0"/>
						<xs:element name="Division" type="globLib:DivisionNameDataTypeV2" minOccurs="0"/>
						<xs:element name="ProjectRole" type="NSF_KeyPersonExpanded_3_3:ProjectRoleDataType"/>
						<xs:element name="NSFID" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="[0-9A-Z]{9}"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="BioSketchsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="BioSketchAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SupportsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="SupportAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="CollaboratorsAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="CollaboratorAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SynergisticActivitiesAttached">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="SynergisticAttached" type="att:AttachedFileDataType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="ProjectRoleDataType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PD/PI"/>
			<xs:enumeration value="Co-PD/PI"/>
			<xs:enumeration value="Other Senior Personnel"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
