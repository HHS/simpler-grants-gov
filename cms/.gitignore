/.env.local

# Installed by Composer
/vendor/
/drush/Commands/contrib/

# Everything under web/ is generated by Composer (Drupal core, contrib and
# scaffold files) except our own code and settings.php.
/web/*
!/web/modules/
/web/modules/*
!/web/modules/custom/
!/web/themes/
/web/themes/*
!/web/themes/custom/
!/web/sites/
/web/sites/*
!/web/sites/default/
/web/sites/default/*
!/web/sites/default/settings.php

# Per-developer overrides
/web/sites/*/settings.local.php

# Tool caches
/.phpunit.cache/
/.phpcs-cache
